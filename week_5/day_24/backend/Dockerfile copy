#Importing our parent image
FROM python:3.14-alpine3.23

#Adding uv to our container
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

#Creating a working directory to store our files
WORKDIR /applications

#Copying our requirements 
COPY ./requirements.txt /applications/requirements.txt

#Installing packages & dependencies inside our new container
RUN uv pip install --system --no-cache -r /applications/requirements.txt

#Copying our project files
COPY . .

#Choosing which port to use
EXPOSE 8000

#Command to run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
